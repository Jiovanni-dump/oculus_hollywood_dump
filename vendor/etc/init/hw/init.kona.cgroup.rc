on early-init
    # Place the init process in guaranteed cgroup as early as possible
    # so that any child processes launch in guaranteed by default
    mkdir /dev/cpuctl/other
    mkdir /dev/cpuctl/other
    write /dev/cpuctl/other/cgroup.procs 1

on init
    # Create the cgroup hierarchy structure
    # Auto-generated by arvr/projects/resource_control/tools/hierarchy
    # Please DO NOT EDIT THIS SECTION MANUALLY
    mkdir /dev/cpuctl/background
    mkdir /dev/cpuctl/dex2oat
    mkdir /dev/cpuctl/foreground
    mkdir /dev/cpuctl/idle
    mkdir /dev/cpuctl/immersive
    mkdir /dev/cpuctl/other
    mkdir /dev/cpuctl/rt
    mkdir /dev/cpuctl/soft-rt
    mkdir /dev/cpuctl/system
    mkdir /dev/cpuctl/system-background
    mkdir /dev/cpuctl/top-app
    mkdir /dev/cpuctl/xr

    # Initialize the cgroup hierarchy
    # Auto-generated by arvr/projects/resource_control/tools/hierarchy
    # Please DO NOT EDIT THIS SECTION MANUALLY
    chown system system /dev/cpuctl/background/tasks
    chown system system /dev/cpuctl/background/cgroup.procs
    chown system system /dev/cpuctl/background/cpu.shares
    chown system system /dev/cpuctl/background/cgroup.pinned
    chmod 0664 /dev/cpuctl/background/tasks
    chmod 0664 /dev/cpuctl/background/cgroup.procs
    chmod 0664 /dev/cpuctl/background/cpu.shares
    chmod 0664 /dev/cpuctl/background/cgroup.pinned
    chown system system /dev/cpuctl/dex2oat/tasks
    chown system system /dev/cpuctl/dex2oat/cgroup.procs
    chown system system /dev/cpuctl/dex2oat/cpu.shares
    chown system system /dev/cpuctl/dex2oat/cgroup.pinned
    chmod 0664 /dev/cpuctl/dex2oat/tasks
    chmod 0664 /dev/cpuctl/dex2oat/cgroup.procs
    chmod 0664 /dev/cpuctl/dex2oat/cpu.shares
    chmod 0664 /dev/cpuctl/dex2oat/cgroup.pinned
    chown system system /dev/cpuctl/foreground/tasks
    chown system system /dev/cpuctl/foreground/cgroup.procs
    chown system system /dev/cpuctl/foreground/cpu.shares
    chown system system /dev/cpuctl/foreground/cgroup.pinned
    chmod 0664 /dev/cpuctl/foreground/tasks
    chmod 0664 /dev/cpuctl/foreground/cgroup.procs
    chmod 0664 /dev/cpuctl/foreground/cpu.shares
    chmod 0664 /dev/cpuctl/foreground/cgroup.pinned
    chown system system /dev/cpuctl/idle/tasks
    chown system system /dev/cpuctl/idle/cgroup.procs
    chown system system /dev/cpuctl/idle/cpu.shares
    chown system system /dev/cpuctl/idle/cgroup.pinned
    chmod 0664 /dev/cpuctl/idle/tasks
    chmod 0664 /dev/cpuctl/idle/cgroup.procs
    chmod 0664 /dev/cpuctl/idle/cpu.shares
    chmod 0664 /dev/cpuctl/idle/cgroup.pinned
    chown system system /dev/cpuctl/immersive/tasks
    chown system system /dev/cpuctl/immersive/cgroup.procs
    chown system system /dev/cpuctl/immersive/cpu.shares
    chown system system /dev/cpuctl/immersive/cgroup.pinned
    chmod 0664 /dev/cpuctl/immersive/tasks
    chmod 0664 /dev/cpuctl/immersive/cgroup.procs
    chmod 0664 /dev/cpuctl/immersive/cpu.shares
    chmod 0664 /dev/cpuctl/immersive/cgroup.pinned
    chown system system /dev/cpuctl/other/tasks
    chown system system /dev/cpuctl/other/cgroup.procs
    chown system system /dev/cpuctl/other/cpu.shares
    chown system system /dev/cpuctl/other/cgroup.pinned
    chmod 0664 /dev/cpuctl/other/tasks
    chmod 0664 /dev/cpuctl/other/cgroup.procs
    chmod 0664 /dev/cpuctl/other/cpu.shares
    chmod 0664 /dev/cpuctl/other/cgroup.pinned
    chown system system /dev/cpuctl/rt/tasks
    chown system system /dev/cpuctl/rt/cgroup.procs
    chown system system /dev/cpuctl/rt/cpu.shares
    chown system system /dev/cpuctl/rt/cgroup.pinned
    chmod 0664 /dev/cpuctl/rt/tasks
    chmod 0664 /dev/cpuctl/rt/cgroup.procs
    chmod 0664 /dev/cpuctl/rt/cpu.shares
    chmod 0664 /dev/cpuctl/rt/cgroup.pinned
    chown system system /dev/cpuctl/soft-rt/tasks
    chown system system /dev/cpuctl/soft-rt/cgroup.procs
    chown system system /dev/cpuctl/soft-rt/cpu.shares
    chown system system /dev/cpuctl/soft-rt/cgroup.pinned
    chmod 0664 /dev/cpuctl/soft-rt/tasks
    chmod 0664 /dev/cpuctl/soft-rt/cgroup.procs
    chmod 0664 /dev/cpuctl/soft-rt/cpu.shares
    chmod 0664 /dev/cpuctl/soft-rt/cgroup.pinned
    chown system system /dev/cpuctl/system/tasks
    chown system system /dev/cpuctl/system/cgroup.procs
    chown system system /dev/cpuctl/system/cpu.shares
    chown system system /dev/cpuctl/system/cgroup.pinned
    chmod 0664 /dev/cpuctl/system/tasks
    chmod 0664 /dev/cpuctl/system/cgroup.procs
    chmod 0664 /dev/cpuctl/system/cpu.shares
    chmod 0664 /dev/cpuctl/system/cgroup.pinned
    chown system system /dev/cpuctl/system-background/tasks
    chown system system /dev/cpuctl/system-background/cgroup.procs
    chown system system /dev/cpuctl/system-background/cpu.shares
    chown system system /dev/cpuctl/system-background/cgroup.pinned
    chmod 0664 /dev/cpuctl/system-background/tasks
    chmod 0664 /dev/cpuctl/system-background/cgroup.procs
    chmod 0664 /dev/cpuctl/system-background/cpu.shares
    chmod 0664 /dev/cpuctl/system-background/cgroup.pinned
    chown system system /dev/cpuctl/top-app/tasks
    chown system system /dev/cpuctl/top-app/cgroup.procs
    chown system system /dev/cpuctl/top-app/cpu.shares
    chown system system /dev/cpuctl/top-app/cgroup.pinned
    chmod 0664 /dev/cpuctl/top-app/tasks
    chmod 0664 /dev/cpuctl/top-app/cgroup.procs
    chmod 0664 /dev/cpuctl/top-app/cpu.shares
    chmod 0664 /dev/cpuctl/top-app/cgroup.pinned
    chown system system /dev/cpuctl/xr/tasks
    chown system system /dev/cpuctl/xr/cgroup.procs
    chown system system /dev/cpuctl/xr/cpu.shares
    chown system system /dev/cpuctl/xr/cgroup.pinned
    chmod 0664 /dev/cpuctl/xr/tasks
    chmod 0664 /dev/cpuctl/xr/cgroup.procs
    chmod 0664 /dev/cpuctl/xr/cpu.shares
    chmod 0664 /dev/cpuctl/xr/cgroup.pinned

    # nnapi-hal cgroup is not used in VROS
    rmdir /dev/cpuctl/nnapi-hal

    # camera-daemon cgroup is not used in VROS
    rmdir /dev/cpuctl/camera-daemon

    # create compositor cpuset for high priority processes
    mkdir /dev/cpuset/compositor 0755 system system
    write /dev/cpuset/compositor/cpus 0-7
    write /dev/cpuset/compositor/mems 0
    chown system system /dev/cpuset/compositor/cpus
    chown system system /dev/cpuset/compositor/tasks
    chmod 0664 /dev/cpuset/compositor/cpus
    chmod 0664 /dev/cpuset/compositor/tasks

    # create syncboss_events cpuset for high frequency
    # real time threads that should favor running on the
    # same core as their waker.
    mkdir /dev/cpuset/syncboss_events
    write /dev/cpuset/syncboss_events/cpus 0-3
    write /dev/cpuset/syncboss_events/mems 0
    write /dev/cpuset/syncboss_events/sched_wake_affine 1
    chown system system /dev/cpuset/syncboss_events/cpus
    chown system system /dev/cpuset/syncboss_events/tasks
    chmod 0664 /dev/cpuset/syncboss_events/cpus
    chmod 0664 /dev/cpuset/syncboss_events/tasks

    # create dev_opt_in cpuset for developer opt in features
    mkdir /dev/cpuset/dev_opt_in 0755 system system
    write /dev/cpuset/dev_opt_in/cpus 0-7
    write /dev/cpuset/dev_opt_in/mems 0
    chown system system /dev/cpuset/dev_opt_in/cpus
    chown system system /dev/cpuset/dev_opt_in/tasks
    chmod 0664 /dev/cpuset/dev_opt_in/cpus
    chmod 0664 /dev/cpuset/dev_opt_in/tasks

    # create immersive cpuset
    mkdir /dev/cpuset/immersive 0755 system system
    write /dev/cpuset/immersive/cpus 4-6
    write /dev/cpuset/immersive/mems 0
    chown system system /dev/cpuset/immersive/cpus
    chown system system /dev/cpuset/immersive/tasks
    chmod 0664 /dev/cpuset/immersive/cpus
    chmod 0664 /dev/cpuset/immersive/tasks

    # create media cpuset
    mkdir /dev/cpuset/media 0755 system system
    write /dev/cpuset/media/cpus 0-2
    write /dev/cpuset/media/mems 0
    chown system system /dev/cpuset/media/cpus
    chown system system /dev/cpuset/media/tasks
    chmod 0664 /dev/cpuset/media/cpus
    chmod 0664 /dev/cpuset/media/tasks

    # create tracking cpuset
    mkdir /dev/cpuset/tracking 0755 system system
    write /dev/cpuset/tracking/cpus 0-7
    write /dev/cpuset/tracking/mems 0
    chown system system /dev/cpuset/tracking/cpus
    chown system system /dev/cpuset/tracking/tasks
    chmod 0664 /dev/cpuset/tracking/cpus
    chmod 0664 /dev/cpuset/tracking/tasks

    # create object_tracking cpuset
    mkdir /dev/cpuset/object_tracking 0755 system system
    write /dev/cpuset/object_tracking/cpus 0-7
    write /dev/cpuset/object_tracking/mems 0
    chown system system /dev/cpuset/object_tracking/cpus
    chown system system /dev/cpuset/object_tracking/tasks
    chmod 0664 /dev/cpuset/object_tracking/cpus
    chmod 0664 /dev/cpuset/object_tracking/tasks

    # create social_presence cpuset
    mkdir /dev/cpuset/social_presence 0755 system system
    write /dev/cpuset/social_presence/cpus 0-7
    write /dev/cpuset/social_presence/mems 0
    chown system system /dev/cpuset/social_presence/cpus
    chown system system /dev/cpuset/social_presence/tasks
    chmod 0664 /dev/cpuset/social_presence/cpus
    chmod 0664 /dev/cpuset/social_presence/tasks

# Enable support for non-guaranteed cpu
on property:persist.device_config.oculus_shared_os_services.oculus_non_guaranteed_cpu=true
    write /dev/cpuctl/idle/cpu.shares 2
