    <assign-permission name="com.oculus.permission.CODEC_AVATAR_INTERNAL" uid="vendor_codecavatardataservice" />
    <assign-permission name="com.oculus.permission.ACCESS_BACKGROUND_INPUT_TRACKING" uid="vendor_codecavatardataservice" />

</permissions>
